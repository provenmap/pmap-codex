{
  "description": "ProvenMap Architect hooks: offline session-start state line (grant, expiry, host MCP entry) — no .provenmap scaffold",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/pmap-architect.js --session-start --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
